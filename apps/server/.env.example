# 服务端口
PORT=8787

# PostgreSQL（业务实体：应用、错误分组、SourceMap、告警）
DATABASE_URL="postgresql://wm:wm_password@localhost:5432/web_monitor?schema=public"

# ClickHouse（海量事件明细与聚合）
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_DATABASE="web_monitor"
CLICKHOUSE_USERNAME="default"
CLICKHOUSE_PASSWORD="wm_password"

# 跨域白名单（逗号分隔，* 表示全部）
CORS_ORIGIN=*

# 服务对外可访问地址（用于远程配置下发时切换 SDK 上报目标，留空则不下发）
PUBLIC_HOST=

# 查询返回的最大事件数上限（防止单次查询拖垮服务）
MAX_QUERY_ROWS=10000

# 告警邮件（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_MAIL_FROM="web-monitor <no-reply@example.com>"

# 告警轮询间隔（秒）
ALERT_CHECK_INTERVAL=60

# 是否在启动时自动初始化 ClickHouse 表结构
CLICKHOUSE_AUTO_INIT=true

# ---- 实时大屏（RealtimeModule）----
REALTIME_PUSH_INTERVAL_MS=5000
REALTIME_RETRY_BASE_MS=10000
REALTIME_RETRY_MAX_MS=60000
REALTIME_MAX_CLIENTS=200
