{
  "name": "@web-monitor/core",
  "version": "0.1.0",
  "description": "web-monitor 采集底座：生命周期、上报管道、会话、上下文、埋点 API 与插件体系",
  "license": "MIT",
  "keywords": ["monitor", "sdk", "observability", "performance", "tracking"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.min.js",
  "jsdelivr": "./dist/index.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@web-monitor/types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.9",
    "jsdom": "^25.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
