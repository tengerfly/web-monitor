{
  "name": "@web-monitor/react",
  "version": "0.1.0",
  "description": "web-monitor React 适配：Provider、Hooks、错误边界与路由埋点",
  "license": "MIT",
  "keywords": ["monitor", "react", "error-boundary", "hooks"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('no tests yet')\""
  },
  "dependencies": {
    "@web-monitor/core": "workspace:*",
    "@web-monitor/types": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
